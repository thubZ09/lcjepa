    "rollout_weight": 0.1,
    "vic_var_weight": 1.0,
    "vic_cov_weight": 0.04,
    "vic_var_target": 1.0
  },
  "optim": {
    "epochs": 50,
    "batch_size": 256,
    "lr": 0.0005,
    "weight_decay": 0.04,
    "warmup_epochs": 5,
    "ema_base": 0.997,
    "ema_final": 1.0,
    "grad_clip": 1.0
  },
  "run": {
    "seed": 0,
    "device": null,
    "out_dir": "runs/scale_31k",
    "log_every": 50,
    "probe_every": 5
  }
}