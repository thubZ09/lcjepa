{
  "data": {
    "source": "ztf",
    "seq_len": 200,
    "n_train": 8000,
    "n_val": 1000,
    "log_tau_range": [
      1.5,
      3.0
    ],
    "log_sigma_range": [
      -1.3,
      -0.3
    ],
    "cadence_days": 3.0,
    "cadence_jitter": 1.0,
    "season_gap_frac": 0.25,
    "phot_err": 0.02,
    "n_jobs": -1,
    "ztf_cache_dir": "data/scale/n31000",
    "ztf_band": "r",
    "ztf_min_epochs": 120,
    "ztf_val_frac": 0.1
  },
  "mask": {
    "n_target_blocks": 4,
